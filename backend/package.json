{
  "name": "finanzas-web",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de Telegram para control de finanzas personales (GTQ) — serverless en AWS",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "set-webhook": "node scripts/set-webhook.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@aws-sdk/client-dynamodb": "^3.1084.0",
    "@aws-sdk/client-lambda": "^3.1085.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1084.0",
    "@aws-sdk/lib-dynamodb": "^3.1084.0",
    "ai": "^7.0.19",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.1",
    "aws-cdk": "^2.1129.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
