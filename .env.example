# Solo para deploy/pruebas LOCALES (el flujo normal es GitHub Actions con
# environment `production`; ahí estos valores viven como secrets).
#
# PowerShell:  Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; if ($k -and -not $k.StartsWith('#')) { Set-Item "env:$k" $v } }
# Bash:        set -a; source .env; set +a

TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=un-secreto-largo-solo-A-Za-z0-9_-
ANTHROPIC_API_KEY=sk-ant-...
ALLOWED_CHAT_ID=123456789

# Proveedores intercambiables (defaults si no se definen)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# LLM_MODEL_AGENT=claude-sonnet-5   (cerebro del agente conversacional)
# STT_PROVIDER=aws

# Para usar MiniMax en vez de Claude:
# LLM_PROVIDER=minimax
# LLM_MODEL=MiniMax-M2
# MINIMAX_API_KEY=...   (key de https://platform.minimax.io)
